# ============================================================
# Eve AI — Environment Variables
# ============================================================

# Model Provider & Name
# Cloud (Gemini): "gemini-1.5-flash" (requires GOOGLE_API_KEY)
# Cloud (OpenRouter): "meta-llama/llama-3.1-8b-instruct:free" (requires OPENROUTER_API_KEY)
# Local (Ollama): "ollama/qwen2.5:7b" (no API key needed)
MODEL_NAME=ollama/qwen2.5:7b

# API Keys (if using cloud models)
GOOGLE_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Tavily API Key — get it at https://app.tavily.com (optional for some features)
TAVILY_API_KEY=your_tavily_api_key_here

# Max words per blog section
SECTION_WORD_BUDGET=300

# Max parallel section writers (keep at 3 for free tier)
MAX_CONCURRENCY=3
